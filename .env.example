# ─── Core server ─────────────────────────────────────────────────────────────
PORT=3000
DATA_FILE=data/store.json
DOCUMENT_DEADLINE=2026-04-07T23:59:59+08:00
FROM_EMAIL=hr@company.local
MAILBOX_ADDRESS=applications@company.local
HR_API_KEY=replace-with-strong-api-key
# Optional multi-key map: key:role,key2:role2 (roles: viewer|hr|admin)
HR_API_KEYS=
# Local/test fallback role when no API key auth is active
LOCAL_AUTH_ROLE=hr
# Required in production: comma-separated CORS allowlist
ALLOWED_ORIGINS=http://localhost:3000

# AES-256-GCM key for encrypting email bodies at rest.
# Generate a strong random value — do NOT reuse across environments.
ENCRYPTION_KEY=replace-with-your-own-long-random-secret
JWT_SECRET=replace-with-your-own-jwt-secret
DEVELOPER_KEY=replace-with-your-developer-registration-key
BCRYPT_ROUNDS=12
COOKIE_SECURE=true

# Optional webhook controls
WEBHOOK_ALLOWED_DOMAINS=
WEBHOOK_TIMEOUT_MS=5000

# ─── Google Sheets integration (optional) ────────────────────────────────────
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_CREDENTIALS_JSON=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TITLE=Hiring Automation Candidates

# ─── Gmail OAuth intake worker ────────────────────────────────────────────────
# Path to your OAuth Desktop credentials JSON downloaded from Google Cloud Console.
# See README > Gmail OAuth Ingestion Worker for full setup instructions.
GMAIL_CREDENTIALS_PATH=credentials.json

# Where the OAuth token is stored after first authorization.
GMAIL_TOKEN_PATH=data/gmail-token.json

# Optional fallback token JSON and/or refresh token.
GMAIL_TOKEN_JSON=
GMAIL_OAUTH_REFRESH_TOKEN=

# OAuth Web App credentials for /api/gmail/oauth/connect + callback flow.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=http://localhost:3000/api/gmail/oauth/callback

# Single connected Gmail inbox used by the intake worker.
GMAIL_INBOX_USER=applications@company.local

# Gmail search query used to find application emails.
GMAIL_POLL_QUERY=subject:(Application for) has:attachment

# Polling interval in milliseconds for --watch mode (default: 60000 = 1 minute).
GMAIL_POLL_INTERVAL_MS=60000

# Optional max messages per poll and processed label for idempotency.
GMAIL_POLL_MAX_RESULTS=50
GMAIL_PROCESSED_LABEL=HireFlow/Processed
GMAIL_SYNC_STATE_PATH=data/gmail-intake-state.json

# Base URL of the hiring-automation API server (used by the worker).
# Must use https:// for non-local hosts.
API_BASE_URL=http://localhost:3000

# API key (optional; must match HR_API_KEY above if set).
API_KEY=

# ─── Gmail outbound dispatcher ────────────────────────────────────────────────
# Set to "true" to send real emails via Gmail API.
# When false (default), dispatches are simulated — useful in development.
GMAIL_DISPATCH_ENABLED=false

# Sender address shown on outbound emails (must be the authorized Gmail account).
GMAIL_DISPATCH_FROM=hr@company.local

# Maximum send retry attempts before marking a dispatch as permanently failed.
GMAIL_DISPATCH_MAX_RETRIES=3

# Base delay in ms for exponential backoff (e.g. 1000 → 1s, 2s, 4s, …).
GMAIL_DISPATCH_RETRY_BASE_MS=1000

# ─── PostgreSQL persistence (optional) ───────────────────────────────────────
# Set to "true" to enable PostgreSQL. When false (default), the app uses the
# local JSON store (data/store.json) which requires no extra infrastructure.
POSTGRES_ENABLED=false

# Full connection string (takes precedence over individual fields below).
# Example: postgres://user:password@localhost:5432/hiring_automation
POSTGRES_URL=

# Individual connection fields (used when POSTGRES_URL is not set).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hiring_automation
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Set to "true" if your database requires SSL (e.g. hosted on Render, Railway,
# Neon, Supabase, or AWS RDS).
POSTGRES_SSL=false
POSTGRES_SSL_CA_PATH=
POSTGRES_SSL_CERT_PATH=
POSTGRES_SSL_KEY_PATH=

# ─── OCR / document parsing worker ───────────────────────────────────────────
# Set to "true" to enable Tesseract OCR for image-only PDFs and image files.
# Requires the tesseract.js package (already in package.json).
# When false (default), the worker still handles text-based PDFs and DOCX files.
OCR_ENABLED=false

# Number of parsing jobs to process in parallel.
OCR_WORKER_CONCURRENCY=2

# Poll interval in milliseconds for --watch mode.
OCR_WORKER_POLL_MS=5000
